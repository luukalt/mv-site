rules_version = '2';

// Iedereen mag het materiaal lezen; alleen de beheerders mogen het wijzigen.
// Houd deze lijst gelijk aan allowedEmails in src/pages/admin.jsx.
function isAdmin() {
  return request.auth != null
    && request.auth.token.email in ['luukaltenburg@gmail.com', 'mariekeversleijen@outlook.com'];
}

service cloud.firestore {
  match /databases/{database}/documents {
    match /contents/{folder}/files/{fileId} {
      allow read: if folder in ['leesbevordering', 'lesideeen', 'boekwijzer'];
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && folder in ['leesbevordering', 'lesideeen', 'boekwijzer']
        && request.resource.data.pdfUrl is string
        && request.resource.data.pdfUrl.matches('https?://.*')
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('https://.*')
        && request.resource.data.order is int;
    }

    // Alles wat hierboven niet genoemd is, is dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
